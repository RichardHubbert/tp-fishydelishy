# ===========================================
# ENVIRONMENT VARIABLES TEMPLATE
# ===========================================
# Copy this file to `.env` in the project root and fill in your values.
# NEVER commit the actual .env file to git!
#
# These values are typically set in your hosting environment (Vercel, Netlify, etc.)
# or locally for development.

# ===========================================
# SUPABASE CONFIGURATION
# ===========================================
# Get these from your Supabase project settings:
# https://app.supabase.com/project/YOUR_PROJECT/settings/api

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anon/public key
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ===========================================
# EMAIL SERVICE (Resend)
# ===========================================
# These are configured as Supabase Edge Function secrets, not in this file.
# To set them:
#   1. Install Supabase CLI: https://supabase.com/docs/guides/cli
#   2. Link your project: supabase link --project-ref YOUR_PROJECT_REF
#   3. Set secrets:
#      supabase secrets set RESEND_API_KEY=your_resend_api_key
#      supabase secrets set RESEND_FROM="Your Restaurant Name <bookings@yourdomain.com>"

# RESEND_API_KEY=re_xxxxxxxxxxxxx
# RESEND_FROM=Your Restaurant Name <bookings@yourdomain.com>

# ===========================================
# ANALYTICS (Optional)
# ===========================================
# Add analytics service API keys if needed
# VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# VITE_FACEBOOK_PIXEL_ID=XXXXXXXXXX

# ===========================================
# THIRD-PARTY INTEGRATIONS (Optional)
# ===========================================
# Add any other service API keys/IDs here
# ElevenLabs, Stripe, etc. are managed per-restaurant in the database
